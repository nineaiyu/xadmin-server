{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "xadmin/schemas/ws-frame.schema.json",
  "title": "WebSocketFrameV1",
  "description": "WebSocket 消息协议 v1 帧（生成物：真源为 message/protocol.py 与 message/ws_schema.py）。上行帧仅需 action；出站帧由 send_base_json 统一携带 code/detail/timestamp/v。新增 action 必须：① 双端 MessageAction 同步登记；② 补对应 payload 定义（message/ws_schema.py 的 PAYLOAD_DECLARATIONS）。服务端由 tests/unit/common/test_contract_schemas.py 与 tests/unit/message/test_ws_frame_schema.py 持续校验。",
  "definitions": {
    "action": {
      "type": "string",
      "enum": [
        "ping",
        "userinfo",
        "push_message",
        "chat_message",
        "chat_recall",
        "chat_reaction",
        "chat_read",
        "chat_unread",
        "task_log",
        "monitor",
        "screen_command",
        "screen_data",
        "screen_page_state"
      ],
      "description": "消息动作枚举（MessageAction）"
    },
    "inboundFrame": {
      "type": "object",
      "description": "客户端 → 服务端帧（客户端受控，键集合封闭）",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "$ref": "#/definitions/action"
        },
        "data": {
          "description": "载荷，由具体 action 决定"
        },
        "mid": {
          "type": "string",
          "description": "客户端回显一致性标记"
        },
        "v": {
          "type": "integer",
          "const": 1
        }
      },
      "additionalProperties": false
    },
    "outboundFrame": {
      "type": "object",
      "description": "服务端 → 客户端帧；服务端可经 send_base_json kwargs 追加顶层键，故不封闭 additionalProperties",
      "required": [
        "code",
        "action",
        "detail",
        "timestamp",
        "v"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "description": "业务码，语义同 ApiResponse.code"
        },
        "action": {
          "$ref": "#/definitions/action"
        },
        "detail": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "data": {
          "description": "载荷，由具体 action 决定"
        },
        "mid": {
          "type": "string"
        },
        "v": {
          "type": "integer",
          "const": 1
        }
      },
      "additionalProperties": true
    },
    "taskLogPayload": {
      "type": "object",
      "description": "task_log 增量帧载荷（system/ws.py push_once，前端 TaskLogDialog 增量渲染契约）",
      "required": [
        "offset",
        "content",
        "finished"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "description": "已推送字节偏移"
        },
        "content": {
          "type": "string",
          "description": "本轮新增内容（空串表示无新增）"
        },
        "finished": {
          "type": "boolean",
          "description": "读到结束标记或执行已终态"
        }
      },
      "additionalProperties": false
    },
    "chatRoomMessagePayload": {
      "type": "object",
      "description": "聊天室消息帧载荷（ws/chat/ 通道 ChatNotify 落库后广播；与历史 ws/message/* 通道的 chat_message 载荷不同）",
      "required": [
        "id",
        "room_id",
        "content"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "description": "消息自增主键（游标）"
        },
        "room_id": {
          "type": "integer"
        },
        "room_type": {
          "type": "string",
          "description": "public / private / ai"
        },
        "sender_pk": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sender_name": {
          "type": "string"
        },
        "sender_avatar": {
          "type": "string"
        },
        "message_type": {
          "type": "string",
          "description": "text / ai / system / image / video / audio / file"
        },
        "content": {
          "type": "string"
        },
        "created_time": {
          "type": "string"
        },
        "client_msg_id": {
          "type": "string",
          "description": "客户端幂等键"
        },
        "extra": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "chatReactionPayload": {
      "type": "object",
      "description": "表情回应上行帧载荷（ws/chat/ 通道 ChatNotify；对消息 add/remove 自己的 emoji 回应，落库后广播全量表）",
      "required": [
        "message",
        "emoji",
        "op"
      ],
      "properties": {
        "message": {
          "type": "integer",
          "description": "目标消息 pk（ChatMessage 自增主键）"
        },
        "emoji": {
          "type": "string",
          "description": "回应表情（去首尾空白后 1-16 字符）"
        },
        "op": {
          "type": "string",
          "description": "add 添加 / remove 移除（remove 只移除自己，不能替他人移除）"
        }
      },
      "additionalProperties": false
    },
    "chatReactionUpdatePayload": {
      "type": "object",
      "description": "表情回应广播帧载荷（ws/chat/ 下行；reactions 为该消息全量回应表，客户端整体替换即可）",
      "required": [
        "room",
        "message",
        "reactions",
        "ts"
      ],
      "properties": {
        "room": {
          "type": "integer",
          "description": "房间 pk"
        },
        "message": {
          "type": "integer",
          "description": "消息 pk"
        },
        "reactions": {
          "type": "object",
          "description": "全量回应表 {emoji: [user_pk, ...]}（整体替换，幂等）"
        },
        "ts": {
          "type": "integer",
          "description": "广播时刻（epoch 秒），客户端可据此丢弃乱序到达的旧帧"
        }
      },
      "additionalProperties": false
    },
    "screenCommandPayload": {
      "type": "object",
      "description": "大屏远程控制帧载荷（ws/screen/<pk> 下行，dataset/ws_screen.py 广播；展示端被动接收）",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "description": "switch / page / refresh / auto；连接回放时为 state"
        },
        "mode": {
          "type": "string",
          "description": "auto 自动轮播 / manual 远程控制停播"
        },
        "index": {
          "type": "integer",
          "description": "当前页码（0 基）"
        },
        "refresh_rev": {
          "type": "integer",
          "description": "数据刷新代数（递增即重拉数据）"
        },
        "rev": {
          "type": "integer",
          "description": "控制态版本号（单调递增）"
        },
        "ts": {
          "type": "string",
          "description": "指令落态时间（ISO）"
        }
      },
      "additionalProperties": false
    },
    "screenDataPayload": {
      "type": "object",
      "description": "大屏聚合数据帧载荷（ws/screen/<pk> 下行；按观察者权限各自聚合后自推，dataset/ws_screen.py 的 screen_data_trigger，不做组广播）",
      "required": [
        "screen",
        "dashboard",
        "rev",
        "cards",
        "errors",
        "ts"
      ],
      "properties": {
        "screen": {
          "type": "string",
          "description": "大屏 pk"
        },
        "dashboard": {
          "type": [
            "string",
            "null"
          ],
          "description": "所属仪表盘 pk（canvas 画布模式为 null；carousel 轮播模式为展示连接上报的当前页）"
        },
        "rev": {
          "type": "integer",
          "description": "控制态版本号（取当前控制态缓存 rev，未下发过指令为 0）"
        },
        "cards": {
          "type": "array",
          "description": "卡片数据 {card, kind: execute|aggregate, data}；data 为 execute/aggregate 返回结构"
        },
        "errors": {
          "type": "array",
          "description": "失败卡片 {card, detail}：数据集被删 / 字段权限 fail-closed 等，不影响其余卡片"
        },
        "ts": {
          "type": "integer",
          "description": "推送时刻（epoch 秒）"
        }
      },
      "additionalProperties": false
    },
    "screenPageStatePayload": {
      "type": "object",
      "description": "大屏展示端当前页上报帧载荷（ws/screen/<pk> 上行，dataset/ws_screen.py 接收；carousel 触发聚合按上报页取数，避免整屏逐页聚合白跑查询）",
      "required": [
        "index"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "description": "当前页码（0 基，按 Screen.dashboards 原序；canvas 模式不上报，非法/越界回退全页聚合）"
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/definitions/inboundFrame"
    },
    {
      "$ref": "#/definitions/outboundFrame"
    }
  ]
}
