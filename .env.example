# xadmin-server 部署环境变量模板：复制为 .env 并修改
#   cp .env.example .env
# 注意：DEP-5 起 compose 不再内置默认密码，缺失必填项将直接报错

TZ=Asia/Shanghai

DB_DATABASE=xadmin
DB_USER=server
# 必填：生产环境务必使用强随机值（如 openssl rand -base64 24 生成）
DB_PASSWORD=change-me-strong-password

# 必填：生产环境务必使用强随机值
REDIS_PASSWORD=change-me-strong-password
REDIS_PORT=6379

# 数据卷根目录，默认仓库上级目录（../）
# VOLUME_DIR=../
