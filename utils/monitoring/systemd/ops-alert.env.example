# 宿主侧运维 agent 的共享环境文件（三个 systemd unit 均以 EnvironmentFile 读取）。
#
#   install -m 600 -o root -g root utils/monitoring/systemd/ops-alert.env.example /etc/xadmin/ops-alert.env
#   vi /etc/xadmin/ops-alert.env    # 填下面对应的值
#
# 令牌来源：系统管理 → 系统配置（SysConfig 的 OPS_ALERT_TOKEN / 指标令牌取 config.yml 的 METRICS_TOKEN）。

# --- 容器 OOM 告警（xadmin-oom-alert.service）---
OPS_ALERT_URL=https://xadmin.example.com/api/common/api/ops-alert
OPS_ALERT_TOKEN=<与系统设置 OPS_ALERT_TOKEN 一致>

# --- SLO 快照（xadmin-slo-snapshot.timer）---
METRICS_URL=http://127.0.0.1:8896/api/common/api/metrics
METRICS_TOKEN=<与 config.yml 的 METRICS_TOKEN 一致>
SLO_SNAPSHOT_FILE=/opt/xadmin/xadmin-server/tmp/slo_snapshots.jsonl
PYTHON=/opt/xadmin/xadmin-server/.venv/bin/python

# --- Prometheus 告警桥接（xadmin-prometheus-alert-bridge.timer）---
PROMETHEUS_URL=http://127.0.0.1:9090
PROMETHEUS_ALERT_STATE=/var/lib/xadmin/prometheus_alerts.json
# 重复抑制窗口（秒）：同一告警持续 firing 时的最小重发间隔，默认 4h
PROMETHEUS_ALERT_REPEAT_SECONDS=14400
