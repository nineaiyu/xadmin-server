FROM registry.cn-beijing.aliyuncs.com/nineaiyu/python:3.14.7-slim

# add pip cn mirrors（腾讯云：阿里云 PyPI 镜像偶有版本同步滞后，曾缺 psycopg-pool==3.3.3 导致构建失败）
ARG PIP_MIRROR=https://mirrors.cloud.tencent.com/pypi/simple
ARG APT_MIRROR=http://mirrors.aliyun.com

# Install APT dependencies
ARG DEPENDENCIES="                    \
        curl                          \
        g++                           \
        make                          \
        pkg-config                    \
        procps                        \
        libmariadb-dev                \
        gettext"

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=core \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=core \
    set -ex \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache \
    && sed -i "s@http://.*.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update > /dev/null \
    && apt-get -y install --no-install-recommends ${DEPENDENCIES} \
    && echo "no" | dpkg-reconfigure dash


# uv 工具链（独立层：改依赖时不会重复下载 uv wheel；pip 缓存走 /root/.cache 挂载复用）
ARG UV_VERSION=0.12.5

RUN --mount=type=cache,target=/root/.cache,id=core \
    pip install "uv==${UV_VERSION}" -i ${PIP_MIRROR}

# install dependencies（版本依据：uv.lock；含 dev 组）
# venv 置于 /data/py3：源码目录 /data/xadmin-server 运行时会被宿主 bind mount 覆盖，
# 环境放在挂载点内会被宿主目录遮蔽。
# 不用 `uv sync --frozen`：--frozen 不重新解析，会直接用 uv.lock 里固化的 pythonhosted.org
# 下载地址、绕过镜像源（astral-sh/uv#19625，详见 Dockerfile-base 同处注释）。
# UV_CONCURRENT_DOWNLOADS 默认 50（uv 默认值）；镜像源按 IP 限流明显时调小（如 4~8）总吞吐反而更高。
# -r 与挂载 target 都用绝对路径：本 RUN 执行时工作目录仍是基础镜像的 /（WORKDIR 在文件末尾才设置），
# 相对路径会解析到 /requirements.txt，报 "File not found: requirements.txt"。
ARG UV_CONCURRENT_DOWNLOADS=50

RUN --mount=type=cache,target=/root/.cache,id=core \
    --mount=type=bind,source=requirements.txt,target=/data/xadmin-server/requirements.txt \
    --mount=type=bind,source=requirements-dev.txt,target=/data/xadmin-server/requirements-dev.txt \
    set -ex \
    && UV_PYTHON_DOWNLOADS=0 uv venv --python-preference only-system /data/py3 \
    && UV_CONCURRENT_DOWNLOADS=${UV_CONCURRENT_DOWNLOADS} \
       uv pip install --python /data/py3 \
          -r /data/xadmin-server/requirements.txt \
          -r /data/xadmin-server/requirements-dev.txt \
          --index-url ${PIP_MIRROR} \
    && uv pip install --python /data/py3 pip setuptools --index-url ${PIP_MIRROR}

ENV PATH=/data/py3/bin:$PATH

WORKDIR /data/xadmin-server/

ENTRYPOINT ["/bin/bash", "entrypoint.sh"]

EXPOSE 8896

STOPSIGNAL SIGQUIT

CMD ["start", "all"]