[run]
# 2026-09-27：纳入 ai / approval / dataset（ADR-057 拆分后的三大业务 app）与 utils，
# 消除 85% 门禁对高复杂度 app 的测量盲区；门禁阈值按全口径实测重校（docs/metrics.md）
source = system,captcha,server,common,message,notifications,demo,settings,mfa,ai,approval,dataset,utils
omit =
    */migrations/*
    */tests/*
    # 仅排除 server/settings 配置包；settings 业务 app 自 2026-09-26 起纳入测量（P2.8 盲区收口）
    server/settings/*
    */wsgi.py
    */asgi.py
    **/apps.py
    **/management/commands/*
[report]
skip_covered = True
