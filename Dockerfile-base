FROM python:3.14.7-slim

# Install APT dependencies
ARG DEPENDENCIES="                    \
        curl                          \
        g++                           \
        make                          \
        pkg-config                    \
        procps                        \
        libmariadb-dev                \
        gettext"

ARG APT_MIRROR=http://deb.debian.org

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=core \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=core \
    set -ex \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache \
    && sed -i "s@http://.*.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update > /dev/null \
    && apt-get -y install --no-install-recommends ${DEPENDENCIES} \
    && echo "no" | dpkg-reconfigure dash


# install dependencies（以 uv.lock 为唯一安装依据）
# requirements*.txt 是 uv export 产物，仅供 pip-audit 与手工安装，容器构建不再消费；
# uv 自身从 PyPI 镜像安装（不依赖 ghcr.io，保证内网与离线环境可构建）。
# --frozen 而非 --locked：--locked 的一致性校验会把当前 index 的候选集一并比对，镜像源与
# PyPI 候选集不完全一致时会误报「lock 需更新」；lock ↔ pyproject 同步由 CI 的 uv lock --check 守护。
WORKDIR /data/

ARG PIP_MIRROR=https://pypi.org/simple
ARG UV_VERSION=0.12.5

RUN --mount=type=cache,target=/root/.cache,id=core \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    set -ex \
    && pip install --no-cache-dir "uv==${UV_VERSION}" -i ${PIP_MIRROR} \
    && UV_PROJECT_ENVIRONMENT=/data/py3 \
       UV_PYTHON_DOWNLOADS=0 \
       UV_LINK_MODE=copy \
       UV_COMPILE_BYTECODE=1 \
       uv sync --frozen --no-dev --python-preference only-system --default-index ${PIP_MIRROR} \
    && uv pip install --python /data/py3 pip setuptools --index-url ${PIP_MIRROR}