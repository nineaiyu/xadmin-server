FROM python:3.14.7-slim

# Install APT dependencies
ARG DEPENDENCIES="                    \
        curl                          \
        g++                           \
        make                          \
        pkg-config                    \
        procps                        \
        libmariadb-dev                \
        gettext"

ARG APT_MIRROR=http://deb.debian.org

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=core \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=core \
    set -ex \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache \
    && sed -i "s@http://.*.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update > /dev/null \
    && apt-get -y install --no-install-recommends ${DEPENDENCIES} \
    && echo "no" | dpkg-reconfigure dash


# install dependencies（以 uv.lock 为唯一安装依据）
# requirements*.txt 是 uv export 产物，仅供 pip-audit 与手工安装，容器构建不再消费；
# uv 自身从 PyPI 镜像安装（不依赖 ghcr.io，保证内网与离线环境可构建）。
# --frozen 而非 --locked：--locked 的一致性校验会把当前 index 的候选集一并比对，镜像源与
# PyPI 候选集不完全一致时会误报「lock 需更新」；lock ↔ pyproject 同步由 CI 的 uv lock --check 守护。
WORKDIR /data/

ARG PIP_MIRROR=https://pypi.org/simple
ARG UV_VERSION=0.12.5
# UV_CONCURRENT_DOWNLOADS 默认 50（uv 默认值）；镜像源按 IP 限流明显时调小（如 4~8）总吞吐反而更高
ARG UV_CONCURRENT_DOWNLOADS=50

# uv 工具链（独立层：改依赖时不会重复下载 uv wheel；pip 缓存走 /root/.cache 挂载复用）
RUN --mount=type=cache,target=/root/.cache,id=core \
    pip install "uv==${UV_VERSION}" -i ${PIP_MIRROR}

# install dependencies（版本依据：uv.lock）
# 为什么不用 `uv sync --frozen`：--frozen 不重新解析，uv 会直接使用 uv.lock 里固化的
# files.pythonhosted.org（PyPI 官方 CDN）下载地址，从而绕过 PIP_MIRROR（astral-sh/uv#19625）——
# 国内直连官方 CDN 实测 10 KB/s 级、走镜像源可达 10+ MB/s，构建耗时差一个数量级。
# 这里改用 uv pip + 镜像源安装同一份导出产物：requirements.txt 与 uv.lock 的一致性由
# tests/unit/test_dependency_manifest.py 守护，版本同样完全可复现。
# UV_CONCURRENT_DOWNLOADS 默认 50（uv 默认值）；镜像源按 IP 限流明显时调小（如 4~8）总吞吐反而更高。
ARG UV_CONCURRENT_DOWNLOADS=50

RUN --mount=type=cache,target=/root/.cache,id=core \
    --mount=type=bind,source=requirements.txt,target=requirements.txt \
    set -ex \
    && UV_PYTHON_DOWNLOADS=0 uv venv --python-preference only-system /data/py3 \
    && UV_CONCURRENT_DOWNLOADS=${UV_CONCURRENT_DOWNLOADS} \
       UV_COMPILE_BYTECODE=1 \
       uv pip install --python /data/py3 -r requirements.txt --index-url ${PIP_MIRROR} \
    && uv pip install --python /data/py3 pip setuptools --index-url ${PIP_MIRROR}